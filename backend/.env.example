PORT=3000

# コメント生成モデル（llama-server）
LOCAL_LLM_URL=http://127.0.0.1:8080/v1/chat/completions
LOCAL_LLM_MODEL=local-comments
LOCAL_LLM_TIMEOUT_MS=120000

# 画像説明モデル（llama-server）
VISION_LLM_URL=http://127.0.0.1:8081/v1/chat/completions
VISION_LLM_MODEL=local-vision

# 音声文字起こしモデル（Liquid Audio server）
AUDIO_LLM_URL=http://127.0.0.1:8082/v1/chat/completions

# 配信要約モデル（llama-server）
SUMMARY_LLM_URL=http://127.0.0.1:8083/v1/chat/completions
SUMMARY_LLM_MODEL=local-summary
SUMMARY_LLM_TIMEOUT_MS=120000
