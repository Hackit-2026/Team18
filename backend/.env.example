# このファイルを .env という名前にコピーして、値を書き換えてください。
# cp .env.example .env

# 使用するAIプロバイダー: openai / custom（未設定なら openai）
# 自作モデルに差し替える場合は custom にし、providers/custom.js を実装する
AI_PROVIDER=openai

# 必須(AI_PROVIDER=openai の場合): OpenAI の API キー
OPENAI_API_KEY=

# 任意: 使用するモデル（未設定ならデフォルト値を使用）
# 映像解析（Vision対応が必要）
VISION_MODEL=gpt-4o-mini
# テキスト生成
TEXT_MODEL=gpt-4o-mini
# 音声の文字起こし
STT_MODEL=whisper-1

# 任意(AI_PROVIDER=custom の場合): 自作APIのURLなど、providers/custom.js から参照する値
CUSTOM_API_URL=

# 任意: サーバーのポート
PORT=3000
